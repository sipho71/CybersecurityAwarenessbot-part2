<Window x:Class="CyberSecurityAwarenessBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberSecurity Awareness Bot"
        Height="650" Width="900"
        MinHeight="500" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#101820">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#1B2838"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,15">

            <StackPanel>
                <TextBlock Text="CYBERSECURITY AWARENESS BOT"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#50FA7B"/>

                <TextBlock Text="Your friendly guide to staying safe online"
                           FontSize="13"
                           Foreground="White"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Chat history -->
        <Border Grid.Row="1"
                Background="#18232F"
                CornerRadius="12"
                Padding="15"
                Margin="0,0,0,15">

            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ASCII art logo -->
                    <TextBlock x:Name="AsciiLogo"
                               FontFamily="Consolas"
                               FontSize="14"
                               Foreground="#8BE9FD"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>

                    <!-- Messages are added here from code -->
                    <StackPanel x:Name="ChatPanel"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Message input -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="MessageInput"
                     Grid.Column="0"
                     Height="45"
                     FontSize="15"
                     Padding="10"
                     VerticalContentAlignment="Center"
                     Background="#263545"
                     Foreground="White"
                     BorderBrush="#50FA7B"
                     CaretBrush="White"
                     Margin="0,0,10,0"/>

            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Content="Send"
                    Height="45"
                    FontSize="15"
                    FontWeight="Bold"
                    Background="#50FA7B"
                    Foreground="#101820"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="3"
                   Text="Think before you click. Stay safe online."
                   Foreground="#AAB7C4"
                   FontSize="12"
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>
